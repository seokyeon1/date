# 카카오 디벨로퍼스 > 내 애플리케이션 > REST API 키 (서버 전용, 절대 노출 금지)
KAKAO_REST_API_KEY=

# Anthropic Console에서 발급한 API 키 (서버 전용)
ANTHROPIC_API_KEY=

# 카카오맵 JS SDK용 JavaScript 키 (지도 렌더링용, 클라이언트에 노출되는 것이 정상)
# 카카오 디벨로퍼스 > 내 애플리케이션 > JavaScript 키
# 사용 전 "플랫폼 > Web" 설정에 실행 도메인(예: http://localhost:3000)을 등록해야 함
NEXT_PUBLIC_KAKAO_JS_KEY=

# SK Open API(Tmap) 보행자 경로 API 키 (서버 전용) - 실제 도보 거리/시간 조회용
# https://openapi.sk.com 에서 무료로 발급 가능. 비워두면 도로 보정 추정치로 자동 폴백함
TMAP_APP_KEY=

# 카카오모빌리티 Directions API 승인 후 사용 (자동차 전용, v1은 미사용)
# KAKAO_MOBILITY_API_KEY=

# Google Cloud Console에서 "Places API (New)" 활성화 후 발급한 API 키 (서버 전용)
# 카카오 로컬 API가 제공하지 않는 실제 영업시간(regularOpeningHours)을 조회하는 데 사용됨.
# 비워두면 영업시간 검증을 완전히 건너뛰고 기존처럼 동작함 (과금: Text Search 요청당 과금되니 주의).
GOOGLE_PLACES_API_KEY=
